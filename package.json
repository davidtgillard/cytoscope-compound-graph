{
  "name": "cytoscape-compound-graph-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @dgillard/cytoscape-compound-graph && npm run build -w demo",
    "dev": "npm run dev -w demo",
    "preview": "npm run preview -w demo",
    "test": "npm run test -w @dgillard/cytoscape-compound-graph",
    "test:coverage": "npm run test:coverage -w @dgillard/cytoscape-compound-graph",
    "docs": "npm run docs -w @dgillard/cytoscape-compound-graph",
    "attw": "npm run build -w @dgillard/cytoscape-compound-graph && npm run attw -w @dgillard/cytoscape-compound-graph"
  },
  "overrides": {
    "vitest": "^4.1.11",
    "@vitest/mocker": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "0.28.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
